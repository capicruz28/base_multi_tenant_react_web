# API Configuration
# ✅ CORRECCIÓN FINAL: Usar backend.app.local
VITE_API_BASE_URL=http://backend.app.local:8000/api/v1

# Auth Configuration
VITE_REFRESH_COOKIE_NAME=refresh_token

# Environment
VITE_ENV=development

# Login UI: white-label contextual (cliente + "Powered by CAXIS"). false = UI clásica
# VITE_LOGIN_CONTEXTUAL_BRANDING=false

# Dedicated Provisioning F4 — alineado con DEDICATED_ENABLED backend. Default: false
VITE_DEDICATED_PROVISIONING_V2=true